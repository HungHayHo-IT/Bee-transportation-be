NODE_ENV=development
PORT=8087
TZ=Asia/Ho_Chi_Minh

POSTGRES_DB=beeops
POSTGRES_USER=beeops
DB_PASSWORD=beeops_dev_pw
DATABASE_URL=postgresql://beeops:beeops_dev_pw@localhost:5442/beeops?schema=public&options=-c%20timezone%3DAsia%2FHo_Chi_Minh

JWT_SECRET=thay-bang-chuoi-ngau-nhien-toi-thieu-32-ky-tu-abcdef
JWT_EXPIRES_IN=12h
COOKIE_SECRET=thay-bang-chuoi-ngau-nhien-khac-toi-thieu-32-ky-tu-xyz
# Chỉ đặt 'true' khi site thật sự chạy qua https: cookie Secure bị trình duyệt
# và app vứt thẳng trên http, nghĩa là đăng nhập im lặng không có tác dụng.
# Bỏ trống / thiếu biến = false (an toàn cho môi trường http như prod hiện tại).
COOKIE_SECURE=false

# OAuth Google cho khách hàng (POST /customer-auth/login/google). Lấy ở Google
# Cloud Console > Credentials > OAuth 2.0 Client ID (loại Web). Thiếu biến này
# thì endpoint đó trả 400 'GOOGLE_CLIENT_ID chưa cấu hình', các luồng đăng nhập
# còn lại vẫn chạy bình thường.
GOOGLE_CLIENT_ID=

# Nhiều origin thì ngăn cách bằng dấu phẩy — dev server Vite chạy :5173,
# còn :3000 là bản build xem thử.
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:3000

SMTP_HOST=smtp.example.com
# 587 = STARTTLS (mo thuong roi nang cap), 465 = TLS ngam.
SMTP_PORT=587
# Khong khai thi tu suy theo cong: 465 -> true, con lai -> false. Chi khai tay
# khi nha cung cap chay TLS ngam tren mot cong khac.
# SMTP_SECURE=true
SMTP_USER=no-reply@beetransportation.vn
SMTP_PASS=changeme
SMTP_FROM=BeeOps <no-reply@beetransportation.vn>

UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=20

# S3-compatible storage cho ảnh news. Có đủ 4 giá trị bên dưới thì backend
# dùng presigned PUT URL — FE upload thẳng lên bucket, không đi qua BE.
# Thiếu -> rơi về ghi đĩa vào ./uploads.
#
# AWS S3:              S3_ENDPOINT rỗng, S3_REGION='ap-southeast-1'
# Cloudflare R2:       S3_ENDPOINT='https://<account>.r2.cloudflarestorage.com'
# DO Spaces:           S3_ENDPOINT='https://sgp1.digitaloceanspaces.com'
# MinIO tự host:       S3_ENDPOINT='https://minio.example.com'
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# CDN / URL public để trả cho FE (bắt buộc với R2/MinIO). AWS có thể để trống.
S3_PUBLIC_URL_BASE=
S3_PRESIGN_EXPIRES=300

SLA_CHECK_CRON=*/15 * * * *
MAIL_FLUSH_CRON=*/2 * * * *
QUOTE_EXPIRY_CRON=0 * * * *
FILE_CLEANUP_CRON=0 3 * * *
PUSH_FLUSH_CRON=*/30 * * * * *

# Push FCM cho khách hàng. Dán NGUYÊN nội dung file service account JSON của
# Firebase (một dòng). ĐỂ TRỐNG = tắt push: app vẫn khởi động bình thường, chỉ
# log một dòng warn lúc start và cron sẽ không đẩy bất kỳ thông báo nào.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Goc cua trang landing va bi mat de goi /api/revalidate ben do. BeeOps goi cua
# nay sau khi luu CMS, va sau khi bat/tat hoac sua mo ta, anh nguoi dai dien —
# nho vay landing hien ngay thay vi doi het cua so cache 60 giay.
# Thieu mot trong hai thi KHONG goi, va landing tu lam moi moi 60 giay.
LANDING_URL=
REVALIDATE_SECRET=

# ---------------------------------------------------------------------------
# Gia tri bi mat trong file nay co the MA HOA. Gia tri nao bat dau bang `enc:`
# se duoc giai ma luc doc; gia tri khong co tien to dung nguyen van, nho vay
# chuyen dan tung bien mot chu khong phai doi het trong mot luot.
#
#   npm run bi-mat -- --tao-khoa     sinh khoa 32 byte
#   npm run bi-mat                   ma hoa mot gia tri (go vao, khong dan vao
#                                    tham so dong lenh - tham so nam lai trong
#                                    lich su shell va trong `ps`)
#
# KHOA PHAI NAM NGOAI FILE NAY. De khoa ngay trong .env thi ma hoa chi la khoa
# cua roi treo chia len nam cua: ai doc duoc file nay la co ca hai. Dat khoa vao
# mot file rieng chmod 600 do root so huu, roi tro toi bang APP_SECRET_KEY_FILE.
# Luc do .env lo lot ra ngoai thi token van vo dung.
#
# APP_SECRET_KEY (khoa nam thang trong bien moi truong) van chay duoc, danh cho
# may phat trien. Dung tren production thi mat gan het tac dung.
APP_SECRET_KEY_FILE=
APP_SECRET_KEY=

# OF1-TMS cua Bee Logistics. BeeOps day don sang do qua webhook TMSBILL.
# Thieu MOT trong ba thi BeeOps KHONG goi va tra 503 — khong goi vao dia chi
# rong con hon goi roi khong biet don di dau.
#
# OF1_TMS_URL la phan goc, KHONG kem /webhook/... — ma chi nhanh va TMSBILL do
# ung dung tu ghep. Beta va production la hai dia chi khac nhau, va TOKEN cua
# hai moi truong cung khac nhau.
#
# Token gan NGUYEN VAN vao header Authorization, khong co `Basic`, khong co
# `Bearer` (muc 2 tai lieu OF1-TMS v1.0). Them tien to vao la bi chan ngay o
# vong ngoai. KHONG commit token vao git.
OF1_TMS_URL=https://of1-beta.datatp.net/platform/plugin/tms/rest/v1.0.0
OF1_COMPANY_CODE=beetran
OF1_TOKEN=

# Trang ky dien tu ben landing. Link gui khach dung goc nay + /<ma>.
SIGN_PAGE_URL=https://beetransportation.vietmind.com.vn/vi-vn/ky
